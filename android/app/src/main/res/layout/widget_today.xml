<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/hd" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Aujourd'hui" android:textColor="@color/ev_accent" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
    <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/r1t" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ev_text" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/r1s" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ev_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/r2t" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ev_text" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/r2s" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ev_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/r3t" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ev_text" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/r3s" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ev_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/r4t" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ev_text" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/r4s" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ev_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/ev_muted" android:textSize="13sp" android:visibility="gone"/>
</LinearLayout>
