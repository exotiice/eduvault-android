                <TextView android:id="@+id/a3s" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/a4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp" android:visibility="gone">
        <FrameLayout android:layout_width="44dp" android:layout_height="wrap_content" android:layout_gravity="top">
            <TextView android:id="@+id/a4dt" android:layout_width="38dp" android:layout_height="38dp"
