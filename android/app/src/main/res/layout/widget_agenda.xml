                    android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/a5" android:layout_width="match_parent" android:layout_height="wrap_content"
