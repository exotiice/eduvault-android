    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="@color/ag_muted" android:textSize="13sp" android:visibility="gone"/>
